      "english": "Open the door!",
      "focus": "command",
      "register": "casual",
      "new_words": ["ประตู"],
      "tip": "เปิด = open (a Phase 7 keyboard word); its opposite is ปิด = close. Commands need no subject or particle in Thai — just the verb.",
      "tokens": [
        { "thai": "เปิด", "roman": "bpə̀ət", "gloss": "to open", "match": "เปิด" },
        { "thai": "ประตู!", "roman": "bprà-dtuu", "gloss": "door" }
      ],
      "audio": null
    },
    {
      "id": "pig_04",
      "speaker": "pig1",
      "listener": "wolf",
      "image": "art/pig_04.webp",
      "thai": "ไม่เปิด!",
      "roman": "mâi bpə̀ət",
      "english": "Not opening!",
      "focus": "negated command",
      "register": "casual",
      "new_words": [],
