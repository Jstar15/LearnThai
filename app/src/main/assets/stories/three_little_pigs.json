      "image": "art/pig_01.webp",
      "thai": "ผมจะทำบ้านจากฟาง",
      "roman": "pǒm jà tham bâan jàak faang",
      "english": "I'll build a house from straw.",
      "focus": "made from",
      "register": "casual",
      "new_words": ["ฟาง"],
      "tip": "ทำจาก = make from. ฟาง is straw; the word appears in ฟางข้าว (rice straw). จาก is also 'from' (จากบ้าน = from home).",
      "tokens": [
        { "thai": "ผม", "roman": "pǒm", "gloss": "I (male)", "match": "ผม" },
        { "thai": "จะ", "roman": "jà", "gloss": "will" },
        { "thai": "ทำ", "roman": "tham", "gloss": "to make", "match": "ทำ" },
        { "thai": "บ้าน", "roman": "bâan", "gloss": "house", "match": "บ้าน" },
        { "thai": "จาก", "roman": "jàak", "gloss": "from", "match": "จาก" },
        { "thai": "ฟาง", "roman": "faang", "gloss": "straw" }
      ],
      "audio": null
    },
    {
      "id": "pig_02",
      "speaker": "pig2",
      "listener": "pig1",
      "image": "art/pig_02.webp",
      "thai": "บ้านไม้ดีกว่า",
      "roman": "bâan mái dii gwàa",
      "english": "A wooden house is better.",
      "focus": "better",
      "register": "casual",
      "new_words": ["ไม้", "กว่า"],
      "tip": "ดี = good → ดีกว่า = better. No 'than' word is needed; กว่า carries it. บ้านไม้ = wood house (the material comes straight after the noun).",
      "tokens": [
        { "thai": "บ้าน", "roman": "bâan", "gloss": "house", "match": "บ้าน" },
        { "thai": "ไม้", "roman": "mái", "gloss": "wood", "note": "บ้านไม้ = wooden house." },
        { "thai": "ดี", "roman": "dii", "gloss": "good", "match": "ดี" },
        { "thai": "กว่า", "roman": "gwàa", "gloss": "more", "note": "Comparative marker." }
      ],
      "audio": null
    },
    {
