      "listener": "pig1",
      "image": "art/pig_05.webp",
      "thai": "ผมจะเป่าบ้านคุณ",
      "roman": "pǒm jà bpào bâan khun",
      "english": "I'll blow your house down.",
      "focus": "future threat",
