        { "thai": "คุณ", "roman": "khun", "gloss": "your", "match": "คุณ" }
      ],
      "audio": null
    },
    {
      "id": "pig_06",
      "speaker": "pig2",
      "listener": "pig1",
      "image": "art/pig_06.webp",
      "thai": "ลมแรงมากหนาวด้วย",
      "roman": "lom rɛɛng mâak nǎao dûai",
      "english": "The wind is strong — and it's cold too.",
      "focus": "weather",
      "register": "casual",
      "new_words": ["ลม", "แรง", "ด้วย"],
      "tip": "แรง = strong (for force, not flavour). หนาว = cold (weather), whereas เย็น = cool/cold to touch — a common mix-up. ด้วย at the end = 'too'.",
      "tokens": [
        { "thai": "ลม", "roman": "lom", "gloss": "wind", "note": "ลมแรง = strong wind." },
        { "thai": "แรง", "roman": "rɛɛng", "gloss": "strong", "note": "For force/wind." },
        { "thai": "มาก", "roman": "mâak", "gloss": "very", "match": "มาก" },
        { "thai": "หนาว", "roman": "nǎao", "gloss": "cold (weather)", "match": "หนาว" },
        { "thai": "ด้วย", "roman": "dûai", "gloss": "too", "note": "End of sentence = also." }
      ],
      "audio": null
    },
