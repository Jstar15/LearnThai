        { "thai": "เผ็ด", "roman": "phèt", "gloss": "spicy", "match": "เผ็ด" },
        { "thai": "ครับ", "roman": "khráp", "gloss": "polite (male)", "note": "Male speakers close statements with ครับ." }
      ],
