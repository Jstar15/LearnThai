        { "thai": "คุณ", "roman": "khun", "gloss": "you", "match": "คุณ" },
        { "thai": "ใจดี", "roman": "jai-dii", "gloss": "kind", "note": "ใจ (heart) + ดี (good)." },
        { "thai": "จริงๆ", "roman": "jing-jing", "gloss": "really", "note": "จริง + ๆ (repeat mark)." }
      ],
      "audio": null
    },
