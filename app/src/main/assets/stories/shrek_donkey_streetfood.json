        { "thai": "ผัดไทย", "roman": "phàt-thai", "gloss": "Pad Thai", "match": "ผัดไทย" },
        { "thai": "แต่", "roman": "dtàe", "gloss": "but", "match": "แต่" },
        { "thai": "ผม", "roman": "pǒm", "gloss": "I (male)", "match": "ผม" },
        { "thai": "ไม่", "roman": "mâi", "gloss": "not", "note": "Negation, before the verb." },
        { "thai": "มี", "roman": "mii", "gloss": "to have", "match": "มี" },
