        { "thai": "เรา", "roman": "rao", "gloss": "we / us", "match": "เรา" },
        { "thai": "จะ", "roman": "jà", "gloss": "will", "note": "Future marker before the verb." },
        { "thai": "กิน", "roman": "gin", "gloss": "to eat", "match": "กิน" },
        { "thai": "อะไร", "roman": "à-rai", "gloss": "what", "match": "อะไร" },
        { "thai": "กัน", "roman": "gan", "gloss": "together", "note": "Friendly closing particle." }
      ],
      "audio": null
