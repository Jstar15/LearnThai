      "tokens": [
        { "thai": "ไม่เป็นไร", "roman": "mâi bpen rai", "gloss": "no worries", "match": "ไม่เป็นไร", "note": "The all-purpose 'it's fine'." },
        { "thai": "ผม", "roman": "pǒm", "gloss": "I (male)", "match": "ผม" },
        { "thai": "เลี้ยง", "roman": "líang", "gloss": "to treat (someone)", "note": "เลี้ยงข้าว = to buy someone a meal." },
        { "thai": "เอง", "roman": "eng", "gloss": "myself", "note": "After a verb: 'I'll do it myself'." }
      ],
      "audio": null
    },
    {
      "id": "sfs_04",
      "speaker": "donkey",
      "listener": "shrek",
      "image": "art/shrek_streetfood_04.webp",
      "thai": "ขอบคุณมากคุณใจดีจริงๆ",
      "roman": "khàawp-khun mâak khun jai-dii jing-jing",
      "english": "Thank you so much — you're really kind.",
