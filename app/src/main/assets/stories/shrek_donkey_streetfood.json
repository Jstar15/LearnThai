        { "thai": "สั่ง", "roman": "sàng", "gloss": "to order", "note": "สั่งอาหาร = order food." },
        { "thai": "อะไร", "roman": "à-rai", "gloss": "what", "match": "อะไร" },
        { "thai": "ดี", "roman": "dii", "gloss": "good", "match": "ดี", "note": "อะไรดี = 'what's good?'" },
        { "thai": "คะ", "roman": "khá", "gloss": "polite (question)", "note": "High tone: turns it into a question." }
