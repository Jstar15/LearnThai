        { "thai": "ต้น", "roman": "dtôn", "gloss": "Ton", "note": "Also 'tree/trunk'." },
        { "thai": "ครับ", "roman": "khráp", "gloss": "polite (male)" },
        { "thai": "คุณ", "roman": "khun", "gloss": "you", "match": "คุณ" },
        { "thai": "สวย", "roman": "sǔai", "gloss": "pretty", "match": "สวย" },
        { "thai": "มาก", "roman": "mâak", "gloss": "very", "match": "มาก" }
