    {
      "id": "date_01",
      "speaker": "ton",
      "listener": "fon",
      "image": "art/date_01.webp",
      "thai": "สวัสดีครับคุณชื่ออะไร",
      "roman": "sà-wàt-dii khráp khun chʉ̂ʉ à-rai",
      "english": "Hi — what's your name?",
      "focus": "asking a name",
      "register": "polite",
      "new_words": ["ชื่อ"],
      "tip": "ชื่ออะไร = 'name what?' — no 'is' in the middle. ครับ makes it polite and a little formal, which is exactly right for a first hello.",
      "tokens": [
        { "thai": "สวัสดี", "roman": "sà-wàt-dii", "gloss": "hello", "match": "สวัสดี" },
        { "thai": "ครับ", "roman": "khráp", "gloss": "polite (male)" },
        { "thai": "คุณ", "roman": "khun", "gloss": "you", "match": "คุณ" },
        { "thai": "ชื่อ", "roman": "chʉ̂ʉ", "gloss": "name", "note": "คุณชื่ออะไร = what's your name?" },
        { "thai": "อะไร", "roman": "à-rai", "gloss": "what", "match": "อะไร" }
      ],
      "audio": null
    },
    {
      "id": "date_02",
