      "register": "polite",
      "new_words": ["ฝน", "ล่ะ"],
      "tip": "แล้วคุณล่ะ = 'and you?' — ล่ะ bounces the same question back, so you never repeat the whole thing. Huge time-saver in conversation.",
      "tokens": [
        { "thai": "ฝน", "roman": "fǒn", "gloss": "Fon", "note": "Also means rain — a common Thai name." },
        { "thai": "ค่ะ", "roman": "khâ", "gloss": "polite (statement)" },
        { "thai": "แล้ว", "roman": "láew", "gloss": "and / then" },
        { "thai": "คุณ", "roman": "khun", "gloss": "you", "match": "คุณ" },
        { "thai": "ล่ะ", "roman": "lâ", "gloss": "and…?", "note": "Bounces the question back." }
      ],
      "audio": null
    },
    {
