        { "thai": "ได้", "roman": "dâi", "gloss": "can", "match": "ได้", "note": "Verb + ได้ = able to." },
        { "thai": "ไหม", "roman": "mǎi", "gloss": "question word" }
      ],
      "audio": null
    },
