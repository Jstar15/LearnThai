      "register": "casual",
      "new_words": ["มา"],
      "tip": "ใคร = who, and Thai puts it where the answer would go — at the front here. มา = come; ที่ marks the place: มาที่บ้าน = come to the house.",
      "tokens": [
        { "thai": "ใคร", "roman": "khrai", "gloss": "who", "match": "ใคร" },
        { "thai": "มา", "roman": "maa", "gloss": "to come", "note": "คู่กับ ไป (go)." },
