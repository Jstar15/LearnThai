      "listener": "pinocchio",
      "image": "art/pinocchio_05.webp",
      "thai": "จมูกของคุณยาวขึ้น",
      "roman": "ja-mùuk khǎawng khun yaao khʉ̂n",
      "english": "Your nose is getting longer!",
      "focus": "more and more",
      "register": "casual",
      "new_words": ["จมูก", "ของ", "ยาว"],
      "tip": "ขึ้น after a describing word means 'more than before' — ยาวขึ้น = longer (it grew). ของ = 'of': จมูกของคุณ = the nose of you.",
      "tokens": [
        { "thai": "จมูก", "roman": "ja-mùuk", "gloss": "nose", "note": "A body part; no space needed." },
        { "thai": "ของ", "roman": "khǎawng", "gloss": "of", "note": "ของผม = mine, ของคุณ = yours." },
        { "thai": "คุณ", "roman": "khun", "gloss": "you", "match": "คุณ" },
        { "thai": "ยาว", "roman": "yaao", "gloss": "long" },
        { "thai": "ขึ้น", "roman": "khʉ̂n", "gloss": "up / more so", "match": "ขึ้น", "note": "After an adjective: 'getting more'." }
      ],
