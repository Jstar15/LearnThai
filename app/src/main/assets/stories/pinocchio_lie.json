      "english": "I'm going — but school is closed.",
      "focus": "adjective after noun",
      "register": "polite",
      "new_words": [],
      "tip": "Thai puts the describing word after the noun: โรงเรียนปิด = school + closed. ไม่มี 'is' in the middle.",
      "tokens": [
        { "thai": "ไป", "roman": "bpai", "gloss": "to go", "match": "ไป" },
