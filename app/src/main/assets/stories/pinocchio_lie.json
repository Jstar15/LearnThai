  "cards": [
    {
      "id": "pin_01",
      "speaker": "geppetto",
      "listener": "pinocchio",
      "image": "art/pinocchio_01.webp",
      "thai": "ปิโนคีโอวันนี้ไปโรงเรียนไหม",
      "roman": "bpì-noo-khîi-oh wan-níi bpai roong-rian mǎi",
      "english": "Pinocchio, are you going to school today?",
      "focus": "question particle",
      "register": "casual",
      "new_words": ["ไหม"],
      "tip": "ไหม at the end turns any statement into a yes/no question — no word order change. ไปโรงเรียน = go + school, no 'to' needed.",
      "tokens": [
        { "thai": "ปิโนคีโอ", "roman": "bpì-noo-khîi-oh", "gloss": "Pinocchio" },
        { "thai": "วันนี้", "roman": "wan-níi", "gloss": "today", "match": "วันนี้" },
        { "thai": "ไป", "roman": "bpai", "gloss": "to go", "match": "ไป" },
        { "thai": "โรงเรียน", "roman": "roong-rian", "gloss": "school", "match": "โรงเรียน" },
        { "thai": "ไหม", "roman": "mǎi", "gloss": "question word", "note": "Yes/no question marker." }
      ],
      "audio": null
    },
    {
