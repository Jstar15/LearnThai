        { "thai": "ปิด", "roman": "bpìt", "gloss": "closed", "match": "ปิด", "note": "ปิด = to close; after a place it means 'closed'." },
        { "thai": "ครับ", "roman": "khráp", "gloss": "polite (male)" }
      ],
      "audio": null
    },
    {
