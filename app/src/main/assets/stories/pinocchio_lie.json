      "english": "No! My nose isn't long.",
      "focus": "denial",
      "register": "polite",
      "new_words": [],
      "tip": "ไม่ใช่ = 'no, that's not right' (used to deny a statement), while ไม่ just negates a verb or adjective. Both appear here.",
      "tokens": [
        { "thai": "ไม่ใช่", "roman": "mâi châi", "gloss": "no / not so", "match": "ไม่ใช่", "note": "Denies what was just said." },
        { "thai": "ครับ", "roman": "khráp", "gloss": "polite (male)" },
